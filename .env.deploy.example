# 文件说明: 复制为 .env.deploy.production，填写本地发布与数据维护凭据。

# ===== Cloudflare Pages =====
# 使用账号级 Pages Write 权限的发布 token。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_BRANCH=main

# ===== Cloudflare R2 =====
# 使用只绑定目标 bucket 的 Object Read & Write S3 凭据。
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
